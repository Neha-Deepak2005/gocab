# ---- core ----
ENV=development
DATABASE_URL=sqlite:///./gocab.db
# DATABASE_URL=postgresql://gocab:gocab@localhost:5432/gocab
JWT_SECRET=replace-with-a-long-random-string
CORS_ORIGINS=http://localhost:3000

# ---- optional: Supabase auth (tokens verified server-side) ----
# SUPABASE_JWT_SECRET=

# ---- optional: Redis (realtime pub/sub across workers, rate limiting, Celery) ----
# REDIS_URL=redis://localhost:6379/0
# USE_CELERY=true

# ---- optional: Stripe (leave empty for demo payments) ----
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
CURRENCY=inr

# ---- optional: Google Maps (otherwise free OSRM routing is used) ----
# GOOGLE_MAPS_API_KEY=

# ---- optional: PostGIS nearby search (needs postgis extension) ----
USE_POSTGIS=false

# ---- optional: email receipts ----
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=app-password
# SMTP_FROM=GoCab <you@gmail.com>

# ---- demo: simulated drivers accept & drive your rides ----
DEMO_BOTS=true
